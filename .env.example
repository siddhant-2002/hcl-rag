# =============================================
# REQUIRED — Set all of these in Vercel dashboard:
# Settings → Environment Variables
# =============================================

# GEMINI_API_KEY: Your Google Gemini API key
GEMINI_API_KEY="your_gemini_api_key_here"

# MONGODB_URI: MongoDB Atlas connection string (MUST be Atlas, not localhost)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hcl_rag
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/hcl_rag"

# AUTH_USERNAME / AUTH_PASSWORD: Fallback admin credentials
# Only used when MongoDB is unavailable
AUTH_USERNAME="admin"
AUTH_PASSWORD="password"

# APP_URL: The deployed URL (e.g. https://your-app.vercel.app)
APP_URL="https://your-app.vercel.app"
